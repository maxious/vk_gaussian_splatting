#version 460
// Viewer DLSS-NR temporal composite: the network's head, blended against the reprojected history, written to a
// dedicated RGBA8 image and to the next history, both in display proxy space.
//
// The reference (3rdparty/OpenDLSS-NR/demo/shaders/nr_composite.comp) works in HDR: it derives the proxy code from
// the scene with proxyComponent(), decodes it back to linear, upgrades the tone map against the original HDR
// scene, and finally writes the rgba8 output through webgiDisplay() (ACES + sRGB). Here the scene input is the
// viewer's display-referred RGBA8 COLOR_MAIN, so its rgb is already the proxy code:
//
//   * no proxyComponent() and no srgbDecode() on the input
//   * the neural estimate is the reference's expression in proxy space, reduced to clamp(proxyCode + head/4)
//   * no upgradeToneMap()/webgiDisplay(), which would tone map and sRGB encode an already display-referred image
//
// The history keeps the reference's convention: it stores truncateHalf(neural), i.e. the same proxy space the
// scene input is in, which is what makes the feedback loop above reproduce the reference's arithmetic.
#extension GL_GOOGLE_include_directive : require
#include "nr_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneColor;      // rgba8 unorm, display-referred
layout(set = 0, binding = 1) uniform sampler2D historyPrev;     // rgba16f neural history, proxy space
layout(set = 0, binding = 2) uniform sampler2D motionTex;       // rg16f, see motionScale / motionBias
layout(std430, set = 0, binding = 3) readonly buffer Head { float head[]; };   // f32 [fullHeight][fullWidth][4]
layout(std140, set = 0, binding = 4) uniform Params {
  uint fullWidth, fullHeight, validWidth, validHeight;
  uint historyValid, seed;
  float blendScale;
  float autoMask, localTone, localStructure, skinStructure, style;
  vec2 motionScale, motionBias;
  uint debugStage, padDbg;
} params;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D historyNext;

vec2 validSize() { return vec2(params.validWidth, params.validHeight); }

vec2 viewerHistoryUv(ivec2 pixel) {
  vec2 motion = texelFetch(motionTex, pixel, 0).xy;
  vec2 uv = (vec2(pixel) + 0.5) / validSize();
  return uv + motion * params.motionScale + params.motionBias;
}

bool viewerHasHistory(ivec2 pixel) {
  vec2 uv = viewerHistoryUv(pixel);
  return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

// The demo's five-tap Catmull-Rom reconstruction. A box or bilinear filter softens the image frame over frame,
// because the history feeds back into the network's input.
vec3 viewerHistorySample(ivec2 pixel) {
  vec2 valid = validSize();
  vec2 position = viewerHistoryUv(pixel) * valid;
  vec2 base = floor(position - 0.5) + 0.5;
  vec2 f = clamp(position - base, vec2(0.0), vec2(1.0));
  vec2 square = f * f; vec2 cube = f * square;
  vec2 w0 = fma(f + cube, vec2(-0.5), square);
  vec2 w1 = (cube * 1.5 - square * 2.5) + 1.0;
  vec2 w3 = (cube - square) * 0.5;
  vec2 w2 = ((1.0 - w0) - w1) - w3;
  vec2 middle = w1 + w2;
  vec2 low = clamp(base - 1.0, vec2(0.5), valid - 0.5) / valid;
  vec2 center = clamp(base + w2 / middle, vec2(0.5), valid - 0.5) / valid;
  vec2 high = clamp(base + 2.0, vec2(0.5), valid - 0.5) / valid;
  vec3 left = textureLod(historyPrev, vec2(low.x, center.y), 0.0).rgb;
  vec3 top = textureLod(historyPrev, vec2(center.x, low.y), 0.0).rgb;
  vec3 mid = textureLod(historyPrev, center, 0.0).rgb;
  vec3 bottom = textureLod(historyPrev, vec2(center.x, high.y), 0.0).rgb;
  vec3 right = textureLod(historyPrev, vec2(high.x, center.y), 0.0).rgb;
  float a = w0.x * middle.y; float b = w0.y * middle.x;
  float c = middle.x * middle.y; float d = w3.y * middle.x; float e = w3.x * middle.y;
  vec3 value = fma(left, vec3(a), top * b);
  value = fma(mid, vec3(c), value);
  value = fma(bottom, vec3(d), value);
  value = fma(right, vec3(e), value);
  return value * (1.0 / (e + (d + (c + (a + b)))));
}

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (id.x >= int(params.validWidth) || id.y >= int(params.validHeight)) return;

  vec3 proxyCode = vec3(finiteNonnegative(texelFetch(sceneColor, id, 0).r),
                        finiteNonnegative(texelFetch(sceneColor, id, 0).g),
                        finiteNonnegative(texelFetch(sceneColor, id, 0).b));

  // DLSS5NR_DEBUG=1: publish the sampled proxy code and skip the network, to tell a defect in the viewer's own
  // passes apart from one in the network output.
  if(params.debugStage == 1u) {
    imageStore(historyNext, id, vec4(proxyCode, 1.0));
    imageStore(outputImage, id, vec4(clamp(proxyCode, vec3(0.0), vec3(1.0)), 1.0));
    return;
  }

  uint feature = (uint(id.y) * params.fullWidth + uint(id.x)) * 4u;

  // DLSS5NR_DEBUG=2: publish the network's own residual (head.xyz) so a comb in the head can be told apart from a
  // comb introduced by applying it.
  if(params.debugStage == 2u) {
    vec3 residual = vec3(head[feature], head[feature + 1u], head[feature + 2u]) * 0.25;
    imageStore(historyNext, id, vec4(residual, 1.0));
    imageStore(outputImage, id, vec4(clamp(residual * 4.0 + 0.5, vec3(0.0), vec3(1.0)), 1.0));
    return;
  }

  // The reference's expression, reduced in proxy space:
  //   clamp((head * 0.03125 + proxyCode * 0.125 - 0.0625) * 8 + 0.5) == clamp(proxyCode + head / 4)
  vec3 neural = clamp(proxyCode + vec3(head[feature], head[feature + 1u], head[feature + 2u]) * 0.25, vec3(0.0), vec3(1.0));

  // Without a history (a reset, or a pixel whose previous position was off screen) the blend weight is 0.
  // exp2(head.w * -1.4426950) is exp(-head.w), so the weight is sigmoid(head.w) * blendScale.
  if (params.historyValid != 0u && viewerHasHistory(id)) {
    float scale = clamp(params.blendScale, 0.0, 1.0);
    float weight = clamp((1.0 / (1.0 + exp2(head[feature + 3u] * uintBitsToFloat(0xbfb8aa3bu)))) * scale, 0.0, 1.0);
    vec3 hist = viewerHistorySample(id);
    neural = fma(vec3(weight), hist - neural, neural);
  }

  vec3 history = vec3(truncateHalf(neural.r), truncateHalf(neural.g), truncateHalf(neural.b));
  imageStore(historyNext, id, vec4(history, 1.0));
  // Display-referred already: no tone map, no sRGB encode on the way out.
  imageStore(outputImage, id, vec4(clamp(history, vec3(0.0), vec3(1.0)), 1.0));
}
