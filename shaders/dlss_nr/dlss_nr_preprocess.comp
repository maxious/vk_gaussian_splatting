#version 460
// Viewer DLSS-NR input features: f32 [fullHeight][fullWidth][16].
//
// The 16 lanes are OpenDLSS-NR's layout (see 3rdparty/OpenDLSS-NR/demo/shaders/nr_preprocess.comp). Two things
// differ here:
//
//   * The scene input is the viewer's display-referred RGBA8 COLOR_MAIN, so its rgb already *is* the display
//     proxy code. The demo has to build it from an HDR rgba16f image with paper-white normalisation, a shoulder
//     and an sRGB encode (proxyComponent); repeating any of that here would double-transform the image.
//
//   * The motion input is the viewer's RG16F COLOR_MOTION, which carries no validity flag, while the demo's
//     rgba32ui velocity buffer does. Validity is derived from the reprojected uv instead. The viewer writes zero
//     motion both for a static surface and for a missed hit (threedgrt_raytrace.rgen.slang), so this is a
//     bounds test, not a hit test.
//
// The conversion from the stored motion to a uv offset is done by the caller through motionScale / motionBias:
//   motion = (currNdc - prevNdc) * viewport * 0.5 + dlssJitter  ->  scale = -1 / viewport, bias = jitter / viewport
//   motion = (currNdc - prevNdc)                                ->  scale = (-0.5, -0.5),   bias = (0, 0)
#extension GL_GOOGLE_include_directive : require
#include "nr_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneColor;      // rgba8 unorm, display-referred (top-down rows)
layout(set = 0, binding = 1) uniform sampler2D historyPrev;     // rgba16f neural history, proxy space
layout(set = 0, binding = 2) uniform sampler2D motionTex;       // rg16f, see motionScale / motionBias
layout(std430, set = 0, binding = 3) writeonly buffer Features { vec4 features[]; };   // 4 x vec4 per pixel
layout(std140, set = 0, binding = 4) uniform Params {
  uint fullWidth, fullHeight, validWidth, validHeight;
  uint historyValid, seed;
  float blendScale;
  float autoMask, localTone, localStructure, skinStructure, style;
  vec2 motionScale, motionBias;
  uint debugStage, padDbg;
} params;

float hashUniform(uint value) {
  uint mixed = value;
  mixed = (mixed >> ((mixed >> 28u) + 4u)) ^ mixed;
  mixed *= 0x108ef2d9u;
  uint integer = ((mixed >> 30u) ^ (mixed >> 8u)) + 1u;
  return float(integer) * uintBitsToFloat(0x33800000u);
}

vec3 gaussian3(uint x, uint y, uint seed) {
  uint base = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (seed * 0x9e3779b9u) ^ 0x243f6a88u;
  base = (base >> ((base >> 28u) + 4u)) ^ base;
  base *= 0x108ef2d9u;
  base = (base >> 22u) ^ base;
  float u0 = hashUniform(base * 0x2c9277b5u + 0xac564b05u);
  float u1 = hashUniform(base * 0xfa6dc5f9u + 0x4712a88eu);
  float u2 = hashUniform(base * 0xcaa5b80du + 0x21dd796bu);
  float u3 = hashUniform(base * 0x83232c31u + 0x3463e0acu);
  float radius0 = sqrt(log2(u0) * uintBitsToFloat(0x3f317218u) * -2.0);
  float radius1 = sqrt(log2(u2) * uintBitsToFloat(0x3f317218u) * -2.0);
  float tau = uintBitsToFloat(0x40c90fdbu);
  return vec3(roundF16(radius0 * cos(u1 * tau)), roundF16(radius0 * sin(u1 * tau)), roundF16(radius1 * cos(u3 * tau)));
}

vec2 validSize() { return vec2(params.validWidth, params.validHeight); }

// Where `pixel` was in the previous frame, in uv. The demo's historyUv() does this from a uv-unit motion texture;
// the viewer's motion needs the scale / bias above applied first.
vec2 viewerHistoryUv(ivec2 pixel) {
  vec2 motion = texelFetch(motionTex, pixel, 0).xy;
  vec2 uv = (vec2(pixel) + 0.5) / validSize();
  return uv + motion * params.motionScale + params.motionBias;
}

// Whether the previous frame has a history for `pixel`: false where its reprojected position left the target.
bool viewerHasHistory(ivec2 pixel) {
  vec2 uv = viewerHistoryUv(pixel);
  return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

// The demo's five-tap Catmull-Rom history reconstruction, over the reprojected uv above.
vec3 viewerHistorySample(ivec2 pixel) {
  vec2 valid = validSize();
  vec2 position = viewerHistoryUv(pixel) * valid;
  vec2 base = floor(position - 0.5) + 0.5;
  vec2 f = clamp(position - base, vec2(0.0), vec2(1.0));
  vec2 square = f * f; vec2 cube = f * square;
  vec2 w0 = fma(f + cube, vec2(-0.5), square);
  vec2 w1 = (cube * 1.5 - square * 2.5) + 1.0;
  vec2 w3 = (cube - square) * 0.5;
  vec2 w2 = ((1.0 - w0) - w1) - w3;
  vec2 middle = w1 + w2;
  vec2 low = clamp(base - 1.0, vec2(0.5), valid - 0.5) / valid;
  vec2 center = clamp(base + w2 / middle, vec2(0.5), valid - 0.5) / valid;
  vec2 high = clamp(base + 2.0, vec2(0.5), valid - 0.5) / valid;
  vec3 left = textureLod(historyPrev, vec2(low.x, center.y), 0.0).rgb;
  vec3 top = textureLod(historyPrev, vec2(center.x, low.y), 0.0).rgb;
  vec3 mid = textureLod(historyPrev, center, 0.0).rgb;
  vec3 bottom = textureLod(historyPrev, vec2(center.x, high.y), 0.0).rgb;
  vec3 right = textureLod(historyPrev, vec2(high.x, center.y), 0.0).rgb;
  float a = w0.x * middle.y; float b = w0.y * middle.x;
  float c = middle.x * middle.y; float d = w3.y * middle.x; float e = w3.x * middle.y;
  vec3 value = fma(left, vec3(a), top * b);
  value = fma(mid, vec3(c), value);
  value = fma(bottom, vec3(d), value);
  value = fma(right, vec3(e), value);
  return value * (1.0 / (e + (d + (c + (a + b)))));
}

vec3 centerProxy(vec3 proxy) {
  return vec3(roundF16(roundF16(roundF16(proxy.r) - 0.5) * 0.125),
              roundF16(roundF16(roundF16(proxy.g) - 0.5) * 0.125),
              roundF16(roundF16(roundF16(proxy.b) - 0.5) * 0.125));
}

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (id.x >= int(params.fullWidth) || id.y >= int(params.fullHeight)) return;
  // The network's padded field mirrors the valid area beyond its edge instead of leaving it undefined.
  int reflectedX = id.x < int(params.validWidth) ? id.x : 2 * int(params.validWidth) - id.x - 2;
  int reflectedY = id.y < int(params.validHeight) ? id.y : 2 * int(params.validHeight) - id.y - 2;
  ivec2 source = ivec2(clamp(reflectedX, 0, int(params.validWidth) - 1),
                       clamp(reflectedY, 0, int(params.validHeight) - 1));

  vec4 raw = texelFetch(sceneColor, source, 0);
  // Display-referred RGBA8: rgb is the proxy code as it stands. Only clamp away NaN / out-of-range values.
  vec3 proxy = vec3(finiteNonnegative(raw.r), finiteNonnegative(raw.g), finiteNonnegative(raw.b));
  vec3 noise = gaussian3(uint(id.x), uint(id.y), params.seed);

  // Diagnostics. The window attention is shift invariant, so a spatially constant field must come back constant:
  // any structure that is a function of (x & 3) after this points at the natural-vs-physical token order, which
  // tiledToken() tiles 4x4. Zeroing the noise separately says whether the comb needs the noise lane at all.
  if(params.debugStage == 3u) {
    proxy = vec3(0.5);
    noise = vec3(0.0);
  } else if(params.debugStage == 4u) {
    noise = vec3(0.0);
  }
  vec3 centered = centerProxy(proxy);

  uint base = (uint(id.y) * params.fullWidth + uint(id.x)) * 4u;
  features[base + 0u] = vec4(noise, 1.0);

  // lanes 7-9: the reprojected previous output, centred like the proxy; without a history (a reset, or a pixel
  // whose previous position was off screen) the current proxy stands in, as on the first frame
  vec3 history = centered;
  if (params.historyValid != 0u && viewerHasHistory(source)) history = centerProxy(viewerHistorySample(source));

  features[base + 1u] = vec4(centered, history.r);
  features[base + 2u] = vec4(history.g, history.b, params.style / 128.0, roundF16(params.localTone));
  features[base + 3u] = vec4(roundF16(params.autoMask > 0.0 ? 1.0 : params.localStructure),
                             roundF16(params.autoMask > 0.0 ? (params.skinStructure < 0.0 ? params.localStructure : params.skinStructure) : -1.0),
                             roundF16(params.autoMask > 0.0 ? params.localStructure : -1.0), 0.0);
}
